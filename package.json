{
  "name": "dluxe-perfumeria-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo de tienda de perfumería con inventario automático y conexión a WooCommerce (SQLite + Node)",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "photos": "node --disable-warning=ExperimentalWarning photos.js",
    "seed:large": "node --disable-warning=ExperimentalWarning seed.js --large",
    "build:netlify": "node scripts/build-netlify.mjs",
    "deploy": "npx netlify-cli build && npx netlify-cli deploy --prod --no-build"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@netlify/blobs": "^11.1.6",
    "@vercel/blob": "^2.9.0"
  }
}
